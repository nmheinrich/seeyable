{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "Seeyable",
  "version": "0.1.0",
  "description": "Operate any webpage by voice or a local agent, through labeled tools. Submit, Pay and Delete always wait for your approval.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1:6123/*", "http://127.0.0.1:6124/*"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Seeyable"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/snapshot-dom.js", "lib/executor.js", "lib/overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
