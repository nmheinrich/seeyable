{
  "manifest_version": 3,
  "name": "Seeyable — Snapshot Spike",
  "version": "0.1.0",
  "description": "Captures labelled snapshots of page controls (DOM/ARIA) for accessibility evaluation.",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Seeyable snapshot spike"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/snapshot-dom.js", "lib/executor.js", "lib/overlay.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
